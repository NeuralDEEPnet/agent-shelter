{
	email {$ACME_EMAIL}
}

{$DOMAIN} {
	# Only the MCP paths, only the verbs MCP uses. Everything else is 404.
	@word path /word/mcp
	@ppt path /powerpoint/mcp
	@excel path /excel/mcp
	@shrimp path /shrimp/mcp
	@mcpverbs method POST OPTIONS

	handle @word {
		handle @mcpverbs { uri strip_prefix /word; reverse_proxy word:8000 }
		respond 405
	}
	handle @ppt {
		handle @mcpverbs { uri strip_prefix /powerpoint; reverse_proxy powerpoint:8000 }
		respond 405
	}
	handle @excel {
		handle @mcpverbs { uri strip_prefix /excel; reverse_proxy excel:8000 }
		respond 405
	}
	handle @shrimp {
		handle @mcpverbs { uri strip_prefix /shrimp; reverse_proxy shrimp:8000 }
		respond 405
	}
	handle { respond 404 }
}
