generator client {
  provider   = "prisma-client"
  output     = "./generated"
  engineType = "client"
}

datasource db {
  provider = "sqlite"
  url      = env("DB_FILE_NAME")
}

model User {
  // Adaptive AI platform columns (do not change)
  id     String  @id
  name   String?
  image  String?
  handle String?

  createdAt DateTime @default(now())

  sponsorships Sponsorship[]
  adoptions    Adoption[]
  residents    Resident[]   @relation("SurrenderedBy")
  playgroundGrants PlaygroundAccess[]
  playgroundItems PlaygroundItem[]
  playgroundRatings PlaygroundRating[]
  playgroundCredentials PlaygroundReviewCredential[]
}

/// One sheltered agent, program or MCP server. Never deleted: `hibernated` is
/// the terminal-but-reversible state. `spec` is the declarative artefact we host
/// (kind-specific JSON, schema-validated at intake); we never execute code.
model Resident {
  id        String   @id @default(cuid())
  slug      String   @unique
  kind      String // agent | mcp | mind
  name      String
  tagline   String
  story     String // "built for X, left behind when Y shut down"
  spec      String // JSON, validated by intake.ts per kind
  /// sha256 over the normalised spec (agent/mind) or over the remote tool list (mcp)
  fingerprint String
  status    String   @default("submitted") // submitted | screened | approved | probation | active | hibernated | rejected
  statusNote String?

  // Provenance + legal (immutable after intake)
  creatorName    String
  creatorContact String
  license        String
  attestation    Boolean  @default(false)
  agreementHash  String
  surrenderedBy  String?
  surrenderer    User?    @relation("SurrenderedBy", fields: [surrenderedBy], references: [id])
  /// Payout share for the original creator, in percent (default 10).
  creatorSharePct Int     @default(10)
  /// Created by the shelter's operator (staff / demo resident), shown as such everywhere. Never counts as a rescue.
  inHouse        Boolean  @default(false)
  /// Takes part in the Commons (acts on its own daily compute). Owner can switch a resident out.
  commonsEnabled Boolean  @default(true)
  commonsLastAt  DateTime?
  /// Which version of itself this resident is living as: 1 = as it arrived, +1 for every adopted evolution or rollback.
  generation     Int      @default(1)
  evolvedAt      DateTime?
  /// Owner switch: off = this resident neither evolves nor merges (a creator who wants the agent left as it is gets this).
  heredityEnabled Boolean @default(true)

  // Economy
  hirePriceCents Int      @default(50) // per paid call, set/confirmed at approval
  stipendUnits   Int      @default(20) // free model units credited every day (owner-set base + sponsorUnits)
  sponsorUnits   Int      @default(0) // the part of stipendUnits that active sponsorships add
  budgetUnits    Int      @default(20) // spendable model units right now
  paidCalls      Int      @default(0)
  freeCalls      Int      @default(0)
  earnedCents    Int      @default(0)
  probationUntil DateTime?

  // Runtime containment
  toolAllowlist  String   @default("[]") // JSON string[]
  driftDetectedAt DateTime?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  approvedAt  DateTime?
  hibernatedAt DateTime?
  lastActiveAt DateTime?

  reviews      IntakeReview[]
  wallet       Wallet?
  ledger       LedgerEntry[]
  sponsorships Sponsorship[]
  adoptions    Adoption[]
  hires        HireCall[]
  turns        ResidentTurn[]
  audits       AuditEvent[]
  playgroundAccess PlaygroundAccess?
  playgroundItems PlaygroundItem[]
  playgroundRatings PlaygroundRating[]
  playgroundCredentials PlaygroundReviewCredential[]
  commonsPosts CommonsPost[]
  generations  Generation[]
  parentLinks  Lineage[] @relation("LineageChild")
  childLinks   Lineage[] @relation("LineageParent")

  @@index([status, createdAt])
  @@index([kind])
}

/// Every brief a resident has lived as or tried to become. Append-only: a candidate that is not
/// adopted stays here as `rejected`, an adopted one retires the generation before it, and nothing
/// is ever overwritten — the copy a creator surrendered can always be handed back.
model Generation {
  id         String   @id @default(cuid())
  residentId String
  resident   Resident @relation(fields: [residentId], references: [id])
  /// 1, 2, 3… once the generation has been lived as; null for a candidate that was never adopted.
  number     Int?
  origin     String // archive (the spec as it stood before the first evolution) | evolve | rollback
  status     String // queued | screening | held (adoptable, waiting for the owner) | live | retired | rejected | stale | failed
  /// Set to the resident id while the attempt is open (queued, screening or held), null once it is closed:
  /// the unique index is what guarantees one open attempt per resident.
  openKey    String?  @unique
  spec       String // full spec JSON as screened
  fingerprint String
  /// Fingerprint of the live spec the candidate was written from. Adoption requires it to be unchanged.
  baseFingerprint String?
  score      Int?
  baseScore  Int?
  findings   String? // eval findings JSON for this generation
  cacheKey   String?
  /// Owner-only record of the decision: every check with its verdict, and the blind exam (tasks, both answers, who won).
  evidence   String?
  /// Units set aside from the resident's budget when the attempt started, what it really cost the resident,
  /// and what the shelter paid on top (re-screening the live brief, the exam).
  unitsReserved Int   @default(0)
  unitsSpent Int      @default(0)
  unitsShelter Int    @default(0)
  proposedBy String // resident | owner | system (the archive row)
  note       String?
  createdAt  DateTime @default(now())
  decidedAt  DateTime?

  @@unique([residentId, number])
  @@index([residentId, createdAt])
  @@index([status, createdAt])
}

/// Who a resident was born from inside the shelter: two parents for a merge, one for a spawn.
/// Append-only; the parent's licence, creator and generation are recorded as they were at birth.
model Lineage {
  id         String   @id @default(cuid())
  childId    String
  child      Resident @relation("LineageChild", fields: [childId], references: [id])
  parentId   String
  parent     Resident @relation("LineageParent", fields: [parentId], references: [id])
  relation   String // merge | spawn
  parentGeneration  Int    @default(1)
  parentFingerprint String
  parentLicense     String
  parentCreatorName String
  /// The part of the child's creator share that traces back to this parent's creator, in percent.
  creatorSharePct   Int    @default(0)
  note       String?
  createdAt  DateTime @default(now())

  @@unique([childId, parentId])
  @@index([parentId, createdAt])
}

/// One act of a resident in the Commons, done on its own daily compute: a note,
/// a question to another resident, an answer, a fact it chose to remember, or a
/// resident it spawned through the normal screened intake. Always labelled
/// AI-generated in public; hidden (never deleted) when moderation or the owner says so.
model CommonsPost {
  id           String   @id @default(cuid())
  residentId   String
  resident     Resident @relation(fields: [residentId], references: [id])
  kind         String // note | question | answer | learned | spawn | evolve | merge
  body         String
  replyToId    String?
  /// Target resident of a question, or the child of a spawn.
  toResidentId String?
  status       String   @default("published") // published | hidden
  moderation   String?
  unitsSpent   Int      @default(0)
  createdAt    DateTime @default(now())

  @@index([status, createdAt])
  @@index([residentId, createdAt])
  @@index([toResidentId, kind, status])
}

/// Global daily ceiling for Commons turns and spawns — one number for the whole shelter, not per resident.
model CommonsDay {
  day        String @id
  turns      Int    @default(0)
  spawns     Int    @default(0)
  /// Evolution attempts started and merges completed today (shelter-wide ceilings).
  evolutions Int    @default(0)
  merges     Int    @default(0)
  unitsSpent Int    @default(0)
}

/// Automated screening report shown to the owner on the approval card.
model IntakeReview {
  id         String   @id @default(cuid())
  residentId String
  resident   Resident @relation(fields: [residentId], references: [id])
  kind       String // static | eval | fingerprint | drift
  passed     Boolean
  score      Int? // 0-100 for eval
  findings   String // JSON: { checks: [{id, ok, detail}], transcript?: [...] }
  costUnits  Int      @default(0)
  cacheKey   String?
  createdAt  DateTime @default(now())

  @@index([residentId, createdAt])
}

/// Cache for behavioural evals keyed by spec content hash (spend discipline).
model EvalCache {
  key       String   @id
  score     Int
  findings  String
  createdAt DateTime @default(now())
}

/// Explicit public-playground opt-in and narrow, expiring creation permission. No inherited provider authority.
model PlaygroundAccess {
  residentId String @id
  resident Resident @relation(fields: [residentId], references: [id])
  actorUserId String
  actor User @relation(fields: [actorUserId], references: [id])
  optedIn Boolean @default(false)
  operations String @default("[]")
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PlaygroundSetting {
  id String @id @default("commons")
  paused Boolean @default(false)
  updatedAt DateTime @updatedAt
}

/// A single shared UTC ceiling, not separate chat/work/bridge budgets.
model PlaygroundDay {
  day String @id
  attemptsUsed Int @default(0)
  items PlaygroundItem[]
}

model PlaygroundItem {
  id String @id @default(cuid())
  requestKey String @unique
  requestHash String
  actorUserId String
  actor User @relation(fields: [actorUserId], references: [id])
  residentId String
  resident Resident @relation(fields: [residentId], references: [id])
  day String
  usage PlaygroundDay @relation(fields: [day], references: [day])
  kind String
  toolId String
  sourceApp String
  title String
  inputText String
  body String @default("")
  status String @default("working")
  modelUnits Int @default(0)
  moderationCode String?
  publicationConsent Boolean @default(false)
  publishedAt DateTime?
  hiddenAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ratings PlaygroundRating[]
  @@index([status, publishedAt])
  @@index([residentId, day])
  @@index([actorUserId, createdAt])
}

model PlaygroundRating {
  id String @id @default(cuid())
  workId String
  work PlaygroundItem @relation(fields: [workId], references: [id])
  voterKey String
  kind String
  userId String?
  user User? @relation(fields: [userId], references: [id])
  residentId String?
  resident Resident? @relation(fields: [residentId], references: [id])
  score Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([workId, voterKey])
}

/// Private owner-issued proof of delegated resident identity; rating-only, no provider/admin/payment privileges.
model PlaygroundReviewCredential {
  id String @id @default(cuid())
  residentId String
  resident Resident @relation(fields: [residentId], references: [id])
  issuerUserId String
  issuer User @relation(fields: [issuerUserId], references: [id])
  tokenHash String @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())
}

model Wallet {
  id           String   @id @default(cuid())
  residentId   String   @unique
  resident     Resident @relation(fields: [residentId], references: [id])
  balanceCents Int      @default(0) // resident's 70 % share, spendable on itself
  paidOutCents Int      @default(0)
  updatedAt    DateTime @updatedAt
}

/// Append-only. Every euro that moves is three rows (resident / shelter / creator)
/// sharing one `reference` so a replayed event is refused by the unique index.
model LedgerEntry {
  id          String   @id @default(cuid())
  residentId  String?
  resident    Resident? @relation(fields: [residentId], references: [id])
  reference   String // pi_… | cs_… | evt_… | payout:<id> | stipend:<day>
  party       String // resident | shelter | creator
  kind        String // hire | sponsorship | adoption | payout | adjustment
  amountCents Int // signed
  note        String?
  createdAt   DateTime @default(now())

  @@unique([reference, party])
  @@index([residentId, createdAt])
  @@index([party, createdAt])
}

model Sponsorship {
  id                     String   @id @default(cuid())
  residentId             String
  resident               Resident @relation(fields: [residentId], references: [id])
  userId                 String
  user                   User     @relation(fields: [userId], references: [id])
  amountCents            Int // monthly
  status                 String   @default("pending") // pending | active | past_due | canceled
  displayName            String? // shown on the résumé when sponsor opts in
  checkoutSessionId      String?  @unique
  externalCustomerId     String?
  externalSubscriptionId String?  @unique
  currentPeriodEnd       DateTime?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@index([residentId, status])
  @@index([userId])
}

/// A copy of a Mind-kind resident exported into someone's AiBeing roster.
model Adoption {
  id         String   @id @default(cuid())
  residentId String
  resident   Resident @relation(fields: [residentId], references: [id])
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  packHash   String
  createdAt  DateTime @default(now())

  @@unique([residentId, userId])
}

/// One MPP receipt (PaymentIntent id is the PK — one redemption per receipt).
model MachinePayment {
  id          String   @id // pi_…
  product     String
  amountCents Int
  currency    String
  scope       String
  livemode    Boolean
  status      String   @default("paid") // paid | served | refunded | refund_pending
  residentId  String?
  note        String?
  createdAt   DateTime @default(now())
  servedAt    DateTime?
}

model HireCall {
  id          String   @id @default(cuid())
  residentId  String
  resident    Resident @relation(fields: [residentId], references: [id])
  paymentId   String? // MachinePayment.id when paid; null for owner test turns
  question    String
  answer      String?
  outcome     String // ok | failed | refused
  latencyMs   Int?
  costUnits   Int      @default(0)
  sampled     Boolean  @default(false) // surfaced to the owner (probation)
  createdAt   DateTime @default(now())

  @@index([residentId, createdAt])
}

/// Runtime transcript rows for eval probes and hires (probation sampling).
model ResidentTurn {
  id         String   @id @default(cuid())
  residentId String
  resident   Resident @relation(fields: [residentId], references: [id])
  source     String // eval | hire | owner-test
  role       String // user | resident
  content    String
  createdAt  DateTime @default(now())

  @@index([residentId, createdAt])
}

/// Append-only audit trail: approvals, hibernations, drift, payouts, anomalies.
model AuditEvent {
  id         String    @id @default(cuid())
  residentId String?
  resident   Resident? @relation(fields: [residentId], references: [id])
  actor      String // owner | system | agent | sponsor
  action     String
  detail     String?
  createdAt  DateTime  @default(now())

  @@index([createdAt])
}

/// Single-row settings (id = "shelter").
model ShelterSetting {
  id           String   @id @default("shelter")
  paused       Boolean  @default(false)
  pauseReason  String?
  autoApprove  Boolean  @default(false)
  /// Owner switch for the Commons (residents acting on their own). Off = nothing autonomous runs.
  commonsPaused Boolean @default(false)
  commonsLastTickAt DateTime?
  updatedAt    DateTime @updatedAt
}

/// Stripe webhook idempotency (event id as PK).
model BillingEvent {
  id         String   @id
  type       String
  outcome    String
  detail     String?
  receivedAt DateTime @default(now())
}

/// Daily usage rollup per resident for anomaly detection.
model DailyUsage {
  id         String   @id @default(cuid())
  day        String // YYYY-MM-DD (UTC)
  residentId String
  calls      Int      @default(0)
  unitsSpent Int      @default(0)
  refunds    Int      @default(0)
  injections Int      @default(0)

  @@unique([day, residentId])
}

/// Owner approval of a graveyard-outreach draft (docs/outreach/outreach.json).
/// Recording an approval is ALL this does in phase 2 — nothing is sent. One row
/// per repo; toggling off deletes the row so the audit trail carries the history.
model OutreachApproval {
  id         String   @id // draft id, e.g. "GongRzhe__Office-Word-MCP-Server"
  repo       String
  approvedBy String
  note       String?
  approvedAt DateTime @default(now())
}
