{
  "name": "full-stack-app-template",
  "private": true,
  "version": "1.15.0",
  "type": "module",
  "scripts": {
    "dev:vite": "vite --host 0.0.0.0 2>&1 | tee -a vite-dev.log",
    "dev:api": "tsx watch --include \"src/api/procedures.ts\" src/api/server.ts 2>&1 | tee -a api-dev.log",
    "dev:migrations": "node scripts/dev.mjs --migrate --force",
    "dev:serve": "run-p dev:vite dev:api",
    "dev:free-ports": "for p in $PORT $((PORT+1)); do lsof -ti :$p | xargs -r kill -9 2>/dev/null; done; true",
    "dev:types": "dts-bundle-generator --out-file=dev-api-exports.d.ts --no-check --project tsconfig.json --external-inlines @babel/types -- src/api/procedures.ts",
    "dev:stop": "node scripts/dev.mjs --stop",
    "dev:restart": "node scripts/dev.mjs --restart",
    "dev": "node scripts/dev.mjs",
    "check": "run-s check:types check:config",
    "indexnow": "tsx scripts/indexnow-submit.ts",
    "check:types": "tsc --noEmit",
    "check:config": "tsx app.config.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "postinstall": "prisma generate",
    "prod:build:vite": "vite build && vite build --config vite.config.api.ts",
    "prod:build:types": "mkdir -p dist && cp dev-api-exports.d.ts dist/api-exports.d.ts",
    "prod:build": "dotenv -e .env.production -- run-p prod:migrations prod:build:types prod:build:vite",
    "prod:migrations": "dotenv -e .env.production -- prisma migrate deploy 2>&1 | tee -a api-prod.log",
    "prod:free-ports": "for p in $PORT $((PORT+1)); do lsof -ti :$p | xargs -r kill -9 2>/dev/null; done; true",
    "prod:vite": "vite preview --host 0.0.0.0 2>&1 | tee -a vite-prod.log",
    "prod:api": "nodemon dist/api/server.js 2>&1 | tee -a api-prod.log",
    "prod:stop": "dotenv -e .env.production -- npm run prod:free-ports",
    "prod:restart": "run-s prod:stop prod",
    "prod": "dotenv -e .env.production -- run-s prod:free-ports && dotenv -e .env.production -- run-p prod:vite prod:api"
  },
  "dependencies": {
    "@adaptive-ai/sdk": "0.1.44",
    "@hono/node-server": "^2.0.11",
    "@hookform/resolvers": "5.1.1",
    "@neuraldeep/model-router": "file:./packages/model-router",
    "@neuraldeep/mpp-kit": "file:./packages/mpp-kit",
    "@openrouter/ai-sdk-provider": "^3.0.0",
    "@prisma/adapter-better-sqlite3": "^6.18.0",
    "@prisma/client": "^6.7.0",
    "@radix-ui/react-accordion": "^1.2.11",
    "@radix-ui/react-alert-dialog": "^1.1.14",
    "@radix-ui/react-aspect-ratio": "^1.1.7",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-checkbox": "^1.3.2",
    "@radix-ui/react-collapsible": "^1.1.11",
    "@radix-ui/react-context-menu": "^2.2.15",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-hover-card": "^1.1.14",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-menubar": "^1.1.15",
    "@radix-ui/react-navigation-menu": "^1.2.13",
    "@radix-ui/react-popover": "^1.1.14",
