    "mppx": "^0.10.1",
    "next-themes": "^0.4.6",
    "nodemon": "^3.1.11",
    "npm-run-all2": "^9.0.2",
    "react": "^19.1.0",
    "react-day-picker": "^9.8.0",
    "react-dom": "^19.1.0",
    "react-hook-form": "^7.60.0",
    "react-resizable-panels": "^3.0.3",
    "recharts": "^2.15.4",
    "sonner": "^2.0.6",
    "stripe": "^22.6.2",
    "superjson": "^2.2.2",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^4.1.11",
    "typed-rpc": "^6.1.1",
    "vaul": "^1.1.2",
    "zod": "^4.0.5"
  },
  "peerDependencies": {
    "@trpc/client": "^10.45.4",
    "@trpc/server": "^10.45.4",
    "openai": "~4.42.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.0.14",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "dotenv-cli": "^11.0.0",
    "dts-bundle-generator": "^9.5.1",
    "eslint": "^9.30.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "prettier": "3.6.2",
    "prisma": "^6.7.0",
    "tsx": "^4.22.4",
    "tw-animate-css": "^1.3.5",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.56.0",
    "vite": "^7.0.4",
    "vite-tsconfig-paths": "^5.1.4"
  },
  "overrides": {
